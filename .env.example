# ── Athena Platform — Environment Configuration Template ──────────────────────
#
# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit secrets.
#
# Variable naming: ATHENA_{SECTION}__{KEY} maps to settings.{section}.{key}
# (double-underscore is the nested delimiter for pydantic-settings)

# ── Platform ──────────────────────────────────────────────────────────────────
ATHENA_ENVIRONMENT=development
ATHENA_LOG_LEVEL=DEBUG

# ── Database (TimescaleDB / PostgreSQL) ───────────────────────────────────────
ATHENA_DATABASE__HOST=localhost
ATHENA_DATABASE__PORT=5432
ATHENA_DATABASE__NAME=athena_dev
ATHENA_DATABASE__USER=athena
ATHENA_DATABASE__PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────────────────────
ATHENA_REDIS__URL=redis://localhost:6379/0

# ── Fyers API (populated per engine — DO NOT store here in production) ────────
# These are placeholders. In production, inject via secrets manager.
# ATHENA_FYERS__APP_ID=
# ATHENA_FYERS__SECRET_KEY=
# ATHENA_FYERS__REDIRECT_URI=
