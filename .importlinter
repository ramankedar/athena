[importlinter]
root_packages =
    athena

# ── Contract 1: Core domain is dependency-free ────────────────────────────────
# athena.core must not import from any other athena subpackage.
# This is the foundational rule: the domain must be portable.
[importlinter:contract:core-is-dependency-free]
name = Core domain has no internal athena imports
type = forbidden
source_modules =
    athena.core
forbidden_modules =
    athena.engines
    athena.shared
    athena.interfaces

# ── Contract 2: Engine peer isolation ────────────────────────────────────────
# No engine may import from a sibling engine directly.
# All cross-engine communication must flow through domain events or
# explicit service ports defined in athena.core.
[importlinter:contract:data-engine-isolation]
name = Data engine does not import from sibling engines
type = forbidden
source_modules =
    athena.engines.data
forbidden_modules =
    athena.engines.research
    athena.engines.intelligence
    athena.engines.trading
    athena.engines.governance
    athena.interfaces

[importlinter:contract:research-engine-isolation]
name = Research engine does not import from sibling engines
type = forbidden
source_modules =
    athena.engines.research
forbidden_modules =
    athena.engines.data.infrastructure
    athena.engines.intelligence
    athena.engines.trading
    athena.engines.governance
    athena.interfaces

[importlinter:contract:trading-engine-isolation]
name = Trading engine does not import from sibling engines
type = forbidden
source_modules =
    athena.engines.trading
forbidden_modules =
    athena.engines.research
    athena.engines.intelligence
    athena.engines.data.infrastructure
    athena.engines.governance
    athena.interfaces

[importlinter:contract:governance-engine-isolation]
name = Governance engine does not import from sibling engines
type = forbidden
source_modules =
    athena.engines.governance
forbidden_modules =
    athena.engines.data.infrastructure
    athena.engines.research
    athena.engines.intelligence
    athena.engines.trading
    athena.interfaces

# ── Contract 3: Shared utilities layer ───────────────────────────────────────
[importlinter:contract:shared-does-not-import-engines]
name = Shared utilities do not import from engines or interfaces
type = forbidden
source_modules =
    athena.shared
forbidden_modules =
    athena.engines
    athena.interfaces

# ── Contract 4: Platform foundation layer ────────────────────────────────────
# athena.platform provides cross-cutting concerns to all engines.
# It may import from athena.core (domain types) but never from engines,
# interfaces, or the legacy shared/ scaffold.
[importlinter:contract:platform-does-not-import-engines]
name = Platform does not import from engines or interfaces
type = forbidden
source_modules =
    athena.platform
forbidden_modules =
    athena.engines
    athena.interfaces

# ── Contract 5: Core remains dependency-free of platform ─────────────────────
[importlinter:contract:core-does-not-import-platform]
name = Core domain does not import from platform layer
type = forbidden
source_modules =
    athena.core
forbidden_modules =
    athena.platform

# ── Contract 6: Time domain layer ────────────────────────────────────────────
# athena.time is the single source of truth for temporal logic.
# It may import from athena.core (domain types like SessionType/MarketSession)
# and from athena.platform (exceptions, logging). It never imports from engines
# or interfaces.
[importlinter:contract:time-does-not-import-engines]
name = Time domain does not import from engines or interfaces
type = forbidden
source_modules =
    athena.time
forbidden_modules =
    athena.engines
    athena.interfaces

# ── Contract 7: Core does not import from time domain ─────────────────────────
[importlinter:contract:core-does-not-import-time]
name = Core domain does not import from time domain
type = forbidden
source_modules =
    athena.core
forbidden_modules =
    athena.time

# ── Contract 8: Storage domain layer ─────────────────────────────────────────
# athena.storage defines persistence interfaces. It may import from athena.core
# (domain types like Tick, OHLCV, Instrument) and from athena.platform
# (exceptions). It must NOT import from engines, interfaces, or the time
# domain (athena.time and athena.storage are peer layers).
[importlinter:contract:storage-does-not-import-engines]
name = Storage domain does not import from engines or delivery layers
type = forbidden
source_modules =
    athena.storage
forbidden_modules =
    athena.engines
    athena.interfaces
    athena.time

# ── Contract 9: Core does not import from storage domain ─────────────────────
[importlinter:contract:core-does-not-import-storage]
name = Core domain does not import from storage domain
type = forbidden
source_modules =
    athena.core
forbidden_modules =
    athena.storage

# ── Contract 10: Assets domain layer ─────────────────────────────────────────
# athena.assets is self-contained. It may import from athena.platform
# (exceptions base class) but NOT from athena.core.domain (it defines its
# own richer types), engines, storage, time, or interfaces.
[importlinter:contract:assets-does-not-import-engines]
name = Assets domain does not import from engines, storage, or peer layers
type = forbidden
source_modules =
    athena.assets
forbidden_modules =
    athena.engines
    athena.interfaces
    athena.storage
    athena.time

# ── Contract 11: Core does not import from assets domain ─────────────────────
[importlinter:contract:core-does-not-import-assets]
name = Core domain does not import from assets domain
type = forbidden
source_modules =
    athena.core
forbidden_modules =
    athena.assets

# ── Contract 12: Market domain layer ─────────────────────────────────────────
# athena.market is a peer layer to athena.time, athena.storage, athena.assets.
# It imports from athena.platform (exceptions) only. No cross-peer imports.
[importlinter:contract:market-does-not-import-peers]
name = Market domain does not import from peer layers or engines
type = forbidden
source_modules =
    athena.market
forbidden_modules =
    athena.engines
    athena.interfaces
    athena.time
    athena.storage
    athena.assets

# ── Contract 13: Core does not import from market domain ──────────────────────
[importlinter:contract:core-does-not-import-market]
name = Core domain does not import from market domain
type = forbidden
source_modules =
    athena.core
forbidden_modules =
    athena.market

# ── Contract 14: Market data domain layer ────────────────────────────────────
# athena.market_data is a peer layer to athena.time, athena.market, athena.assets,
# athena.storage. It may import from athena.core (for Symbol, Price, Quantity)
# and athena.platform (for exceptions). No cross-peer imports.
[importlinter:contract:market-data-does-not-import-peers]
name = Market data domain does not import from peer layers or engines
type = forbidden
source_modules =
    athena.market_data
forbidden_modules =
    athena.engines
    athena.interfaces
    athena.time
    athena.market
    athena.assets
    athena.storage

# ── Contract 15: Core does not import from market_data domain ─────────────────
[importlinter:contract:core-does-not-import-market-data]
name = Core domain does not import from market data domain
type = forbidden
source_modules =
    athena.core
forbidden_modules =
    athena.market_data

# ── Contract 16: Feature domain layer ────────────────────────────────────────
# athena.features is a peer layer to athena.market_data, athena.assets, etc.
# It imports from athena.platform (exceptions) only. No cross-peer imports.
[importlinter:contract:features-does-not-import-peers]
name = Feature domain does not import from peer layers or engines
type = forbidden
source_modules =
    athena.features
forbidden_modules =
    athena.engines
    athena.interfaces
    athena.time
    athena.market
    athena.assets
    athena.storage
    athena.market_data

# ── Contract 17: Core does not import from features domain ────────────────────
[importlinter:contract:core-does-not-import-features]
name = Core domain does not import from features domain
type = forbidden
source_modules =
    athena.core
forbidden_modules =
    athena.features
